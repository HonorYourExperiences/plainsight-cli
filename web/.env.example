# Copy to .env.local and fill in. Only BETTER_AUTH_SECRET is needed to run locally with email sign-in.

# The site's own address (where it's deployed), and a long random secret: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Database. Leave empty for a local SQLite file in .data/; use Postgres in production (Neon, Supabase...).
DATABASE_URL=

# Google sign-in: console.cloud.google.com > APIs & Services > Credentials > OAuth client (Web).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in and repo picker: github.com/settings/developers > New OAuth App.
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 1 lets users pick private repos too. It asks GitHub for the broad "repo" permission (read AND write),
# so leave it off until you've decided you want that responsibility.
PLAINSIGHT_GITHUB_PRIVATE_REPOS=

# Email sign-in links, sent with Resend (resend.com). Without a key, local development prints the link instead.
RESEND_API_KEY=
EMAIL_FROM=Plainsight <sign-in@your-domain.com>
